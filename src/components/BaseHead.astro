---
import { business } from '../data/business';
interface Props { title: string; description: string; canonicalUrl: string; image?: string; }
const { title, description, canonicalUrl, image = '/default-og.jpg' } = Astro.props;
const ogImage = new URL(image, Astro.site ?? Astro.url).toString();
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: business.name,
  url: canonicalUrl,
  image: ogImage,
  description: description,
  servesCuisine: ['Indonesian', 'Western', 'Breakfast'],
  priceRange: 'Rp25000-Rp75000',
  address: { '@type': 'PostalAddress', streetAddress: business.address, addressLocality: business.city, addressCountry: 'ID' },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'], opens: '07:00', closes: '22:00' },
  ],
  aggregateRating: { '@type': 'AggregateRating', ratingValue: String(business.rating), reviewCount: String(business.reviewCount) },
};
if (business.phone) jsonLd.telephone = business.phoneDisplay;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonicalUrl} />
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<!-- PERF: Playfair Display max 3 varian + display=swap, tanpa @import -->
<link
  href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,800;1,700&display=swap"
  rel="stylesheet"
/>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
