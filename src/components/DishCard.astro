---
/* Ref: Awwwards GEM — on-hover dish preview (foto zoom + info); Ref: Themetags — menu highlight visual. */
interface Props {
  name: string; price: string; badge: string; desc: string;
  img: string; imgW?: number; imgH?: number; waHref: string; eager?: boolean;
}
const { name, price, badge, desc, img, imgW = 800, imgH = 450, waHref, eager = false } = Astro.props;
---
<article class="dish group border border-green-800/15 rounded-2xl overflow-hidden bg-white/50 flex flex-col">
  <div class="relative overflow-hidden">
    <!-- PERF: lokal terverifikasi 1000px + decoding async -->
    <img src={img} alt={name} width={imgW} height={imgH} decoding="async" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} class="dish-img w-full aspect-video object-cover" />
    <span class="absolute left-3 top-3 text-[11px] font-bold tracking-wide uppercase bg-[#f5f4ef]/95 text-green-800 border border-green-800/25 rounded-full px-3 py-1">{badge}</span>
    <span class="absolute right-3 bottom-3 font-mono-num text-xs font-semibold bg-stone-900/80 text-white rounded-full px-3 py-1.5 opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition duration-300" aria-hidden="true">Lihat detail &rarr;</span>
  </div>
  <div class="p-5 sm:p-6 flex flex-col flex-1">
    <h3 class="font-editorial font-bold text-xl leading-snug">{name}</h3>
    <p class="mt-1 text-sm text-stone-600">{desc}</p>
    <div class="pt-4 mt-auto border-t border-green-800/10 flex items-center justify-between gap-3">
      <p class="font-mono-num font-semibold text-green-800 whitespace-nowrap">{price}</p>
      <a href={waHref} target="_blank" rel="noopener" class="border border-green-800 text-green-800 px-5 py-2.5 min-h-[48px] inline-flex items-center rounded-full text-sm font-semibold hover:bg-green-800 hover:text-green-50 active:scale-[0.97] transition">Pesan via WA</a>
    </div>
  </div>
</article>
