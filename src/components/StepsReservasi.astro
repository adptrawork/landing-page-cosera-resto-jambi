---
// Ref: Plerdy 2025 — CTA Reserve/Order di tiap segmen; cara reservasi 3 langkah + tombol WA + catatan jam sibuk.
import { business } from '../data/business';
const wa = `https://wa.me/${business.phone}?text=${encodeURIComponent('Halo Cosera Resto, saya mau reservasi meja.')}`;
const steps = [
  { n: '01', t: 'Isi form / chat WA', d: 'Kirim tanggal, jam, dan jumlah tamu — tanpa akun.' },
  { n: '02', t: 'Admin konfirmasi slot', d: 'Meja dan paket menu disiapkan sebelum kamu datang.' },
  { n: '03', t: 'Datang & bayar transparan', d: 'Harga dine-in dikonfirmasi ulang, tanpa DP misterius.' },
];
---
<!-- Ref: Plerdy 2025 — 3 langkah reservasi + CTA WA -->
<section aria-label="Cara reservasi" class="max-w-6xl mx-auto px-4">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
    <div class="md:col-span-4">
      <p class="font-mono-num text-xs tracking-[0.18em] uppercase text-green-800">Cara reservasi</p>
      <h2 class="font-editorial mt-2 text-3xl md:text-4xl leading-none font-bold">Meja siap dalam 3 langkah</h2>
      <p class="mt-3 text-base text-stone-600">Grup arisan/rapat: reservasi H-1 agar slot aman.</p>
      <a href={wa} target="_blank" rel="noopener" class="mt-5 inline-flex items-center justify-center bg-green-800 text-green-50 px-7 py-3.5 min-h-[48px] rounded-full font-semibold hover:-translate-y-0.5 active:scale-[0.97] transition">Chat WA sekarang</a>
      <p class="mt-3 text-xs text-stone-600">Catatan jam sibuk: padat 12.00–13.30 &amp; 18.30–21.00 — sarapan sebelum 09.00 paling lengang.</p>
    </div>
    <ol class="md:col-span-8 divide-y divide-green-800/15 border-y border-green-800/15">
      {steps.map((s) => (
        <li class="py-5 flex gap-5 min-w-0">
          <span class="font-mono-num text-sm text-green-800 pt-1 shrink-0">{s.n}</span>
          <div class="min-w-0">
            <h3 class="font-semibold text-lg">{s.t}</h3>
            <p class="mt-1 text-base text-stone-600">{s.d}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
