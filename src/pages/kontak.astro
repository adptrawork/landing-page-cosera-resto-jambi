---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
import MapFacade from '../components/MapFacade.astro';
import { business, notes } from '../data/business';
const faqs = [
  { q: 'Perlu reservasi atau bisa langsung datang?', a: 'Bisa walk-in, tapi reservasi via WA 0822-7807-1017 menjamin meja — terutama jam makan dan akhir pekan.' },
  { q: 'Apakah buka untuk sarapan?', a: 'Ya. CO.SERA buka setiap hari 07.00–22.00, termasuk menu sarapan untuk keluarga.' },
  { q: 'Bagaimana cara reservasi meja?', a: 'Isi form di halaman ini lalu kirim — pesan terformat otomatis terbuka di WhatsApp admin. Tanpa akun.' },
  { q: 'Apakah harga GoFood sama dengan dine-in?', a: 'Belum tentu. Harga GoFood belum termasuk PPN dan dapat berbeda dengan harga makan di tempat.' },
];
const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout title="Kontak CO.SERA Jambi — Reservasi & Rute Sipin" description="Reservasi meja CO.SERA Jambi: Jl Sumantri Brojonegoro 119, buka 07.00–22.00 tiap hari, WA 0822-7807-1017, Instagram @cosera.id. Form 1 menit + FAQ reservasi." canonicalPath="/kontak" image="/images/cosera-kopsus.jpg">
  <section class="max-w-6xl mx-auto px-4 pt-12 md:pt-16 w-full">
    <p class="font-mono-num text-xs tracking-[0.18em] uppercase text-green-800">Kontak &bull; reservasi</p>
    <h1 class="font-editorial mt-2 text-4xl md:text-6xl leading-[1.04] font-bold max-w-[16ch]">Meja sudah menunggu sejak jam tujuh</h1>
  </section>
  <section class="max-w-6xl mx-auto px-4 py-10 md:py-12 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
      <div class="md:col-span-5 min-w-0">
        <div class="border border-green-800/15 rounded-2xl p-6 sm:p-8 bg-white/50">
          <h2 class="font-editorial text-2xl font-bold">Alamat redaksi rasa</h2>
          <p class="mt-2 text-base text-stone-600">{business.address}</p>
          <h2 class="font-editorial mt-8 text-2xl font-bold">Jam buka</h2>
          <p class="mt-2 text-base text-stone-600">{business.hours}</p>
          <p class="mt-6 font-mono-num font-semibold text-green-800">{business.phoneDisplay}</p>
          <p class="mt-1 text-xs text-stone-500">{business.phoneNote}</p>
          <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm">
            <a href={business.instagram} target="_blank" rel="noopener" class="underline underline-offset-4 decoration-green-800/50 min-h-[48px] inline-flex items-center">Instagram &mdash; {business.instagramLabel}</a>
            <a href={business.gofood} target="_blank" rel="noopener" class="underline underline-offset-4 decoration-green-800/50 min-h-[48px] inline-flex items-center">GoFood &mdash; pesan antar</a>
          </div>
          {notes.map((n) => (<p class="mt-4 text-sm text-stone-500 border-l-2 border-green-800 pl-3">{n}</p>))}
        </div>
        <div class="mt-6">
          <h2 class="font-editorial text-2xl font-bold">Tanya jawab reservasi</h2>
          <div class="mt-3"><Faq faqs={faqs} /></div>
        </div>
      </div>
      <div class="md:col-span-7 min-w-0">
        <!-- Ref: form 48px + error di bawah input + helper; JS DIET is:inline -->
        <form id="resv" class="bg-green-800 text-green-50 rounded-2xl p-6 sm:p-8" novalidate>
          <h2 class="font-editorial text-2xl font-bold">Form reservasi &rarr; WhatsApp</h2>
          <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-5 text-sm">
            <div>
              <label for="nama" class="font-semibold">Nama</label>
              <input id="nama" name="nama" required placeholder="Nama kamu" autocomplete="name" class="mt-1 w-full rounded-2xl px-4 py-3 text-stone-800 min-h-[48px]" />
              <p class="mt-1 text-xs text-green-200/80">Wajib diisi — nama pemesan meja.</p>
              <p data-err="nama" class="hidden mt-1 text-sm text-red-200 font-medium">Isi nama dulu ya.</p>
            </div>
            <div>
              <label for="pax" class="font-semibold">Jumlah tamu</label>
              <input id="pax" name="pax" type="number" min="1" max="200" value="2" required inputmode="numeric" class="mt-1 w-full rounded-2xl px-4 py-3 text-stone-800 min-h-[48px]" />
              <p class="mt-1 text-xs text-green-200/80">Grup arisan/rapat disarankan H-1.</p>
              <p data-err="pax" class="hidden mt-1 text-sm text-red-200 font-medium">Jumlah minimal 1 orang.</p>
            </div>
            <div>
              <label for="tgl" class="font-semibold">Tanggal</label>
              <input id="tgl" name="tgl" type="date" required class="mt-1 w-full rounded-2xl px-4 py-3 text-stone-800 min-h-[48px]" />
              <p class="mt-1 text-xs text-green-200/80">Minimal hari ini.</p>
              <p data-err="tgl" class="hidden mt-1 text-sm text-red-200 font-medium">Pilih tanggal hari ini atau sesudahnya.</p>
            </div>
            <div>
              <label for="jam" class="font-semibold">Jam</label>
              <input id="jam" name="jam" type="time" required class="mt-1 w-full rounded-2xl px-4 py-3 text-stone-800 min-h-[48px]" />
              <p class="mt-1 text-xs text-green-200/80">Dapur menyala 07.00–22.00.</p>
              <p data-err="jam" class="hidden mt-1 text-sm text-red-200 font-medium">Pilih jam kedatangan.</p>
            </div>
          </div>
          <button type="submit" class="mt-6 bg-green-50 text-green-800 px-7 py-3.5 min-h-[48px] rounded-full text-sm font-bold active:scale-[0.97] transition">Kirim reservasi via WA</button>
        </form>
        <script is:inline>
          (function () {
            var form = document.getElementById('resv');
            if (!form) return;
            function err(n, on) {
              var p = form.querySelector('[data-err="' + n + '"]');
              if (p) p.classList.toggle('hidden', !on);
            }
            form.addEventListener('submit', function (e) {
              e.preventDefault();
              var nama = document.getElementById('nama').value.trim();
              var pax = parseInt(document.getElementById('pax').value, 10);
              var tgl = document.getElementById('tgl').value;
              var jam = document.getElementById('jam').value;
              var ok = true;
              if (!nama) { err('nama', true); ok = false; } else err('nama', false);
              if (!(pax >= 1)) { err('pax', true); ok = false; } else err('pax', false);
              var today = new Date().toISOString().slice(0, 10);
              if (!tgl || tgl < today) { err('tgl', true); ok = false; } else err('tgl', false);
              if (!jam) { err('jam', true); ok = false; } else err('jam', false);
              if (!ok) return;
              var msg = 'Halo Cosera Resto, saya mau reservasi meja. Nama: ' + nama + ', ' + pax + ' orang, tanggal ' + tgl + ' jam ' + jam + '. Apakah tersedia?';
              window.open('https://wa.me/6282278071017?text=' + encodeURIComponent(msg), '_blank');
            });
          })();
        </script>
        <div class="mt-6"><MapFacade /></div>
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</BaseLayout>
