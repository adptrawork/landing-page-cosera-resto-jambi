---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, notes } from '../data/business';
const faqs = [
  { q: 'Perlu reservasi atau bisa langsung datang?', a: 'Bisa walk-in, tapi reservasi via WA 0822-7807-1017 menjamin meja — terutama jam makan dan akhir pekan.' },
  { q: 'Apakah buka untuk sarapan?', a: 'Ya. CO.SERA buka setiap hari 07.00–22.00, termasuk menu breakfast untuk sarapan keluarga.' },
  { q: 'Bagaimana cara reservasi meja?', a: 'Isi form di halaman ini lalu kirim — pesan terformat otomatis terbuka di WhatsApp admin.' },
  { q: 'Apakah harga GoFood sama dengan dine-in?', a: 'Belum tentu. Harga GoFood belum termasuk PPN dan dapat berbeda dengan harga makan di tempat.' },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout title="Kontak CO.SERA Jambi — Reservasi & Rute Sipin" description="Reservasi meja CO.SERA Jambi: Jl Sumantri Brojonegoro 119, buka 07.00–22.00 tiap hari, WA 0822-7807-1017, Instagram @cosera.id. Form 1 menit + FAQ reservasi." canonicalPath="/kontak" image="/images/cosera-kopsus.jpg">
  <section class="max-w-6xl mx-auto px-4 pt-12 w-full">
    <p class="font-mono-num text-xs tracking-[0.18em] uppercase text-green-800">Kontak &bull; reservasi</p>
    <h1 class="font-editorial mt-2 text-4xl md:text-6xl leading-[1.04] font-bold max-w-[16ch]">Meja sudah menunggu sejak jam tujuh</h1>
  </section>
  <section class="max-w-6xl mx-auto px-4 py-10 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <div class="md:col-span-5 reveal">
        <div class="border border-green-800/15 rounded-2xl p-8 h-full bg-white/50">
          <h2 class="font-editorial text-2xl font-bold">Alamat redaksi rasa</h2>
          <p class="mt-2 text-base text-stone-600">{business.address}</p>
          <h2 class="font-editorial mt-8 text-2xl font-bold">Jam buka</h2>
          <p class="mt-2 text-base text-stone-600">{business.hours}</p>
          <p class="mt-6 font-mono-num font-semibold text-green-800">{business.phoneDisplay}</p>
          <p class="mt-1 text-xs text-stone-500">{business.phoneNote}</p>
          <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm">
            <a href={business.instagram} target="_blank" rel="noopener" class="underline underline-offset-4 decoration-green-800/50">Instagram &mdash; {business.instagramLabel}</a>
            <a href={business.gofood} target="_blank" rel="noopener" class="underline underline-offset-4 decoration-green-800/50">GoFood &mdash; pesan antar</a>
          </div>
          {notes.map((n) => (<p class="mt-4 text-sm text-stone-500 border-l-2 border-green-800 pl-3">{n}</p>))}
        </div>
        <div class="mt-6">
          <h2 class="font-editorial text-2xl font-bold">Tanya jawab reservasi</h2>
          <div class="mt-3 divide-y divide-green-800/15 border-y border-green-800/15">
            {faqs.map((f) => (
              <details class="py-4 group">
                <summary class="cursor-pointer font-semibold text-[15px] list-none flex justify-between gap-4">{f.q}<span class="text-green-800 transition-transform duration-300 group-open:rotate-45">+</span></summary>
                <p class="mt-2 text-sm text-stone-600">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
      <div class="md:col-span-7 reveal">
        <form id="resv" class="bg-green-800 text-green-50 rounded-2xl p-8">
          <h2 class="font-editorial text-2xl font-bold">Form reservasi &rarr; WhatsApp</h2>
          <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
            <label class="flex flex-col gap-1.5">Nama<input required name="nama" placeholder="Nama kamu" class="rounded-2xl px-4 py-3 text-stone-800 min-h-[48px]" /></label>
            <label class="flex flex-col gap-1.5">Jumlah tamu<input required name="pax" type="number" min="1" value="2" class="rounded-2xl px-4 py-3 text-stone-800 min-h-[48px]" /></label>
            <label class="flex flex-col gap-1.5">Tanggal<input required name="tanggal" type="date" class="rounded-2xl px-4 py-3 text-stone-800 min-h-[48px]" /></label>
            <label class="flex flex-col gap-1.5">Jam<input required name="jam" type="time" class="rounded-2xl px-4 py-3 text-stone-800 min-h-[48px]" /></label>
          </div>
          <p id="resv-err" class="hidden mt-3 text-sm text-red-200">Lengkapi semua kolom dan pilih tanggal hari ini atau sesudahnya.</p>
          <button type="submit" class="mt-6 bg-green-50 text-green-800 px-7 py-3.5 rounded-full text-sm font-bold active:scale-[0.97] transition">Kirim reservasi via WA</button>
        </form>
        <script>
          const form = document.getElementById('resv') as HTMLFormElement | null;
          form?.addEventListener('submit', (e) => {
            e.preventDefault();
            const fd = new FormData(form);
            const tgl = String(fd.get('tanggal') || '');
            const today = new Date().toISOString().slice(0, 10);
            const err = document.getElementById('resv-err');
            if (!fd.get('nama') || !fd.get('pax') || !tgl || !fd.get('jam') || tgl < today) {
              err?.classList.remove('hidden');
              return;
            }
            err?.classList.add('hidden');
            const msg = `Halo Cosera Resto, saya mau reservasi meja. Nama: ${fd.get('nama')}, ${fd.get('pax')} orang, tanggal ${tgl} jam ${fd.get('jam')}. Apakah tersedia?`;
            window.open(`https://wa.me/6282278071017?text=${encodeURIComponent(msg)}`, '_blank');
          });
        </script>
        <div class="mt-6 rounded-2xl overflow-hidden border border-green-800/15 bg-green-800/5 h-[320px]">
          <iframe title={`Peta ${business.name}`} src={business.mapsEmbed} loading="lazy" class="w-full h-full"></iframe>
        </div>
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</BaseLayout>
