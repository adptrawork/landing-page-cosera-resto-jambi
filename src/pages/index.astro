---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, menuGroups, notes } from '../data/business';
const cta = `https://wa.me/${business.phone}?text=${encodeURIComponent('Halo Cosera Resto, saya mau reservasi meja.')}`;
---
<BaseLayout title={business.title} description={business.description} canonicalPath={business.canonicalPath} image={business.ogImage}>
  <section class="max-w-7xl mx-auto px-4 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center min-h-[88dvh] py-10">
      <div class="md:col-span-7 reveal">
        <p class="flex items-center gap-2 text-sm font-medium text-amber-700">
          <svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M128 16l36 74 82 12-59 58 14 82-73-38-73 38 14-82-59-58 82-12z"/></svg>
          <span class="font-mono-num">{business.rating}</span>
          <span class="text-zinc-500">• {business.category} • {business.city}</span>
        </p>
        <h1 class="mt-4 text-4xl md:text-6xl tracking-tighter leading-none font-bold">CO.SERA — Resto &amp; Coffee di Sipin Jambi</h1>
        <p class="mt-5 text-base text-gray-600 leading-relaxed max-w-[65ch]">Di Jl. Sumantri Brojonegoro No.119, buka setiap hari 07.00–22.00. Tenderloin steak Rp149,5rb, soto ayam Rp45,5rb, carbonara Rp71,5rb (harga GoFood terverifikasi). Reservasi meja via WA.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={cta} target="_blank" rel="noopener" class="bg-amber-700 text-white px-7 py-3.5 rounded-full font-medium transition-all duration-300 hover:-translate-y-0.5">Reservasi via WA</a>
          <a href="/menu" class="border border-zinc-300 px-7 py-3.5 rounded-full font-medium hover:border-zinc-950">Lihat Menu</a>
        </div>
        <div class="mt-8 flex divide-x divide-zinc-200 border-t border-zinc-200 pt-5 text-sm">
          <div class="pr-6"><p class="font-mono-num font-semibold">07–22</p><p class="text-zinc-500">Buka Tiap Hari</p></div>
          <div class="px-6"><p class="font-mono-num font-semibold">6</p><p class="text-zinc-500">Menu Andalan</p></div>
          <div class="pl-6"><p class="font-mono-num font-semibold">4</p><p class="text-zinc-500">Paket Acara</p></div>
        </div>
      </div>
      <div class="md:col-span-5 reveal">
        <img src="/images/cosera-steak.jpg" alt="Tenderloin steak juicy di atas hot plate" width="1000" height="667" loading="eager" fetchpriority="high" class="w-full aspect-[4/5] object-cover rounded-[2.5rem] border border-slate-200/50 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]" />
        <p class="mt-3 text-xs text-zinc-400">Sumber: Wikimedia Commons (ilustrasi menu sejenis) — ganti foto asli</p>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-8 w-full">
    <p class="text-sm font-medium text-amber-700">Keunggulan</p>
    <h2 class="mt-2 text-3xl md:text-4xl tracking-tighter leading-none font-bold max-w-[20ch]">Kenapa makan di CO.SERA?</h2>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-12 gap-6">
      <div class="md:col-span-7 reveal"><div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-8 md:p-10 h-full">
        <img src="/images/cosera-soto.jpg" alt="Mangkuk soto ayam bening dengan suwiran ayam" width="1000" height="750" loading="lazy" class="w-full h-44 object-cover rounded-3xl" />
        <p class="mt-4 font-semibold text-lg tracking-tight">Menu nasional sampai internasional</p>
        <p class="mt-1 text-base text-gray-600">Dari soto ayam bening dan nasi goreng hingga steak dan carbonara — lengkap untuk selera keluarga.</p>
      </div></div>
      <div class="md:col-span-5 reveal"><div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-8 md:p-10 h-full">
        <p class="font-semibold text-lg tracking-tight">Buka 07.00–22.00 tiap hari</p>
        <p class="mt-1 text-base text-gray-600">Sarapan, makan siang, hingga nongkrong malam — termasuk pilihan menu breakfast.</p>
      </div></div>
      <div class="md:col-span-5 reveal"><div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-8 md:p-10 h-full">
        <p class="font-semibold text-lg tracking-tight">Harga GoFood transparan</p>
        <p class="mt-1 text-base text-gray-600">Tiga menu terverifikasi GoFood. Catatan: harga belum termasuk PPN.</p>
      </div></div>
      <div class="md:col-span-7 reveal"><div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-8 md:p-10 h-full">
        <img src="/images/cosera-carbonara.jpg" alt="Spaghetti carbonara creamy dengan taburan keju" width="1000" height="562" loading="lazy" class="w-full h-44 object-cover rounded-3xl" />
        <p class="mt-4 font-semibold text-lg tracking-tight">Cocok untuk acara dan rombongan</p>
        <p class="mt-1 text-base text-gray-600">Rapat, ulang tahun, arisan, hingga family gathering — atur slot via WA.</p>
      </div></div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-12 w-full">
    <p class="text-sm font-medium text-amber-700">Menu andalan</p>
    <h2 class="mt-2 text-3xl md:text-4xl tracking-tighter leading-none font-bold">Tiga terlaris yang terverifikasi</h2>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-12 gap-6">
      {menuGroups[0].items.slice(0, 3).map((m, i) => (
        <article class:list={['reveal', i === 0 ? 'md:col-span-7' : 'md:col-span-5', i === 2 ? 'md:col-span-12' : '']}>
          <div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-8 h-full">
            <div class="flex flex-col sm:flex-row gap-6">
              <img src={`/images/${m.img === 'steak' ? 'cosera-steak.jpg' : m.img === 'soto' ? 'cosera-soto.jpg' : 'cosera-carbonara.jpg'}`} alt={m.name} width="400" height="267" loading="lazy" class="sm:w-56 w-full h-40 object-cover rounded-3xl shrink-0" />
              <div>
                <p class="text-xs font-medium text-emerald-700">{m.status}</p>
                <h3 class="mt-1 font-semibold text-lg tracking-tight">{m.name}</h3>
                <p class="font-mono-num font-semibold mt-1">{m.price}</p>
                <a href="/menu" class="mt-3 inline-block underline underline-offset-4 text-sm">Lihat menu lengkap</a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-12 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-5">
        <p class="text-sm font-medium text-amber-700">Lokasi</p>
        <h2 class="mt-2 text-3xl md:text-4xl tracking-tighter leading-none font-bold">Rating <span class="font-mono-num">{business.rating}</span> di Google Maps</h2>
        <p class="mt-3 text-base text-gray-600 leading-relaxed">{business.address}. <a class="underline underline-offset-4 text-zinc-900" href={business.mapsUrl} target="_blank" rel="noopener">Lihat di Google Maps</a></p>
        {notes.map((n) => (<p class="mt-3 text-sm text-zinc-500 border-l-2 border-amber-700 pl-3">{n}</p>))}
      </div>
      <div class="md:col-span-7">
        <div class="rounded-[2.5rem] overflow-hidden border border-slate-200/50 aspect-video bg-zinc-100">
          <iframe title={`Peta ${business.name}`} src={business.mapsEmbed} loading="lazy" class="w-full h-full"></iframe>
        </div>
        <p class="mt-3 text-xs text-zinc-500">{business.address} — {business.hours}</p>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-14 w-full">
    <div class="md:pl-[12vw]">
      <h2 class="text-3xl md:text-4xl tracking-tighter leading-none font-bold max-w-[20ch]">Lapar? Amankan meja sebelum jam ramai</h2>
      <p class="mt-3 text-base text-gray-600 max-w-[65ch]">Reservasi via WA atau pesan lewat GoFood untuk makan di rumah.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={cta} target="_blank" rel="noopener" class="bg-amber-700 text-white px-8 py-3.5 rounded-full font-medium">Reservasi via WA</a>
        <a href={business.gofood} target="_blank" rel="noopener" class="border border-zinc-300 px-8 py-3.5 rounded-full font-medium">Pesan via GoFood</a>
      </div>
    </div>
  </section>
</BaseLayout>
