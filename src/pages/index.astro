---
import BaseLayout from '../layouts/BaseLayout.astro';
import InfoStrip from '../components/InfoStrip.astro';
import DishCard from '../components/DishCard.astro';
import StepsReservasi from '../components/StepsReservasi.astro';
import ReviewMaps from '../components/ReviewMaps.astro';
import Faq from '../components/Faq.astro';
import { business, menuGroups, waLink } from '../data/business';
const cta = `https://wa.me/${business.phone}?text=${encodeURIComponent('Halo Cosera Resto, saya mau reservasi meja.')}`;
const imgSrc: Record<string, string> = {
  steak: '/images/cosera-steak.jpg', soto: '/images/cosera-soto.jpg',
  carbonara: '/images/cosera-carbonara.jpg', nasgor: '/images/cosera-nasgor.jpg',
  kopsus: '/images/cosera-kopsus.jpg', matcha: '/images/cosera-matcha.jpg',
};
const highlights = [menuGroups[0].items[0], menuGroups[0].items[1], menuGroups[0].items[2], menuGroups[1].items[0]];
const suasana = [
  { f: 'cosera-steak.jpg', w: 1000, h: 667, alt: 'Area makan keluarga CO.SERA', cap: 'Indoor keluarga — meja besar' },
  { f: 'cosera-nasgor.jpg', w: 1000, h: 689, alt: 'Suasana makan malam CO.SERA', cap: 'Malam santai — nongkrong & arisan' },
  { f: 'cosera-kopsus.jpg', w: 1000, h: 1301, alt: 'Sudut kopi CO.SERA', cap: 'Sudut kopi — ganti foto asli' },
  { f: 'cosera-soto.jpg', w: 1000, h: 750, alt: 'Sarapan pagi CO.SERA jam 07.00', cap: 'Sarapan 07.00 — buka paling pagi' },
];
const quotes = [
  { q: 'Steaknya juicy, porsinya tidak pelit. Anak-anak betah, orang tua tenang.', by: 'Keluarga — Jelutung' },
  { q: 'Sarapan jam tujuh sebelum kantor — soto beningnya juara.', by: 'Karyawan — Sipin' },
  { q: 'Booking arisan via WA dibalas cepat, meja sudah siap saat datang.', by: 'Ibu-ibu arisan' },
];
const faqs = [
  { q: 'Kapan jam paling sibuk?', a: 'Padat 12.00–13.30 dan 18.30–21.00. Sarapan sebelum 09.00 paling lengang; malam minggu disarankan reservasi.' },
  { q: 'Apakah ada parkir?', a: 'Area parkir tersedia di sekitar Jl. Sumantri Brojonegoro — untuk rombongan, konfirmasi slot via WA agar disiapkan.' },
  { q: 'Bisa untuk grup besar / acara?', a: 'Bisa — rapat kantor, ultah, arisan, hingga katering. Lihat halaman Paket Acara lalu tanya kapasitas via WA.' },
  { q: 'Bagaimana pembayarannya?', a: 'Bayar di tempat dengan harga transparan. Harga GoFood belum termasuk PPN dan dapat berbeda dengan dine-in.' },
];
const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout title="CO.SERA Jambi — Resto Keluarga & Sarapan 07.00 di Sipin" description="CO.SERA resto & coffee Sipin Jambi: resto keluarga buka 07.00–22.00 tiap hari. Tenderloin steak, soto ayam, carbonara, paket acara. Reservasi 0822-7807-1017." canonicalPath={business.canonicalPath} image={business.ogImage}>
  <!-- Ref: Awwwards GEM homepage hero + Plerdy 2025 nav/CTA jelas -->
  <!-- 01 HERO -->
  <section class="max-w-6xl mx-auto px-4 w-full pt-10 md:pt-14">
    <p class="font-mono-num text-xs tracking-[0.18em] uppercase text-green-800 reveal">Resto keluarga &bull; Buka 07.00&ndash;22.00 &bull; Rating {business.rating}</p>
    <h1 class="font-editorial mt-4 text-4xl md:text-6xl leading-[1.04] font-bold max-w-[16ch] reveal">Sarapan pagi, kumpul malam — semua acara keluarga di satu meja.</h1>
    <div class="mt-6 grid grid-cols-1 md:grid-cols-12 gap-6 items-end">
      <p class="md:col-span-7 text-base text-stone-600 leading-relaxed reveal">{business.address}. Tenderloin steak Rp149,5rb, soto ayam Rp45,5rb, carbonara Rp71,5rb (harga GoFood terverifikasi).</p>
      <div class="md:col-span-5 flex flex-col sm:flex-row gap-3 md:justify-end reveal">
        <a href="/menu" class="text-center bg-green-800 text-green-50 px-7 py-3.5 min-h-[48px] inline-flex items-center justify-center rounded-full font-semibold hover:-translate-y-0.5 active:scale-[0.97] transition">Lihat Menu</a>
        <a href="/kontak" class="text-center border border-stone-300 px-7 py-3.5 min-h-[48px] inline-flex items-center justify-center rounded-full font-semibold hover:border-green-800 hover:text-green-800 active:scale-[0.97] transition">Reservasi</a>
      </div>
    </div>
    <figure class="mt-8 reveal">
      <img src="/images/cosera-steak.jpg" alt="Tenderloin steak juicy di atas hot plate — CO.SERA Jambi" width="1000" height="667" decoding="async" loading="eager" fetchpriority="high" class="w-full aspect-video object-cover rounded-2xl border border-green-800/15" />
      <figcaption class="mt-2 flex flex-wrap justify-between gap-2 text-xs text-stone-500"><span>Tenderloin steak — menu terlaris GoFood CO.SERA Jelutung.</span><span class="font-mono-num">Foto ilustrasi sejenis &mdash; ganti foto asli</span></figcaption>
    </figure>
  </section>

  <!-- 02 INFO STRIP -->
  <div class="py-6 md:py-8"><InfoStrip waHref={cta} /></div>

  <!-- Ref: Themetags — menu highlight visual -->
  <!-- 03 MENU HIGHLIGHTS -->
  <section aria-label="Menu andalan" class="max-w-6xl mx-auto px-4 py-12 md:py-16">
    <div class="flex items-end justify-between gap-4 min-w-0">
      <div class="min-w-0">
        <p class="font-mono-num text-xs tracking-[0.18em] uppercase text-green-800">Menu highlights</p>
        <h2 class="font-editorial mt-2 text-3xl md:text-4xl leading-none font-bold">Koran kuliner CO.SERA</h2>
        <p class="mt-2 text-base text-stone-600">Harga hijau = terverifikasi GoFood; dine-in bisa berbeda + PPN.</p>
      </div>
      <a href="/menu" class="shrink-0 text-sm font-semibold underline underline-offset-4 decoration-green-800 min-h-[48px] inline-flex items-center">E-menu penuh</a>
    </div>
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-5">
      {highlights.map((m, i) => (
        <DishCard name={m.name} price={m.price} badge={m.status} desc={m.desc} img={imgSrc[m.img]} eager={i === 0} waHref={waLink(`Halo Cosera Resto, saya mau pesan ${m.name} (${m.price}). Apakah tersedia?`)} />
      ))}
    </div>
  </section>

  <!-- 04 SUASANA -->
  <section aria-label="Suasana" class="max-w-6xl mx-auto px-4 py-12 md:py-16 border-t border-green-800/10">
    <p class="font-mono-num text-xs tracking-[0.18em] uppercase text-green-800">Suasana</p>
    <h2 class="font-editorial mt-2 text-3xl md:text-4xl leading-none font-bold">Ruang keluarga, sudut kopi, parkir aman</h2>
    <p class="dropcap mt-4 text-base text-stone-600 max-w-[65ch]">Indoor keluarga, area grup untuk arisan dan rapat, sudut kopi untuk nongkrong, dan akses parkir untuk rombongan.</p>
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-5">
      {suasana.map((s) => (
        <figure class="min-w-0">
          <img src={`/images/${s.f}`} alt={s.alt} width={s.w} height={s.h} decoding="async" loading="lazy" class="w-full aspect-video object-cover rounded-2xl border border-green-800/15" />
          <figcaption class="mt-2 text-sm text-stone-500">{s.cap}</figcaption>
        </figure>
      ))}
    </div>
    <a href="/galeri" class="mt-5 inline-flex items-center underline underline-offset-4 decoration-green-800 text-sm font-semibold min-h-[48px]">Lihat galeri lengkap</a>
  </section>

  <!-- 05 CARA RESERVASI -->
  <div class="py-12 md:py-16 border-t border-green-800/10"><StepsReservasi /></div>

  <!-- 06 REVIEWS + MAPS -->
  <div class="py-12 md:py-16 border-t border-green-800/10"><ReviewMaps quotes={quotes} /></div>

  <!-- 07 FAQ + FINAL CTA -->
  <section aria-label="FAQ dan reservasi" class="max-w-6xl mx-auto px-4 py-12 md:py-16 border-t border-green-800/10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
      <div class="md:col-span-7 min-w-0">
        <p class="font-mono-num text-xs tracking-[0.18em] uppercase text-green-800">FAQ</p>
        <h2 class="font-editorial mt-2 text-3xl md:text-4xl font-bold">Sering ditanyakan</h2>
        <div class="mt-5"><Faq faqs={faqs} /></div>
      </div>
      <div class="md:col-span-5">
        <div class="bg-green-800 text-green-50 rounded-2xl p-8 md:p-10 md:sticky md:top-24">
          <p class="font-mono-num text-xs tracking-[0.18em] uppercase text-green-200">Pagi hari</p>
          <h2 class="font-editorial mt-2 text-2xl md:text-3xl font-bold leading-tight">Lapar jam tujuh? Dapur sudah menyala.</h2>
          <p class="mt-2 text-green-100/90 text-sm">Satu dari sedikit resto Sipin yang buka 07.00 — sarapan keluarga sebelum sekolah dan kantor.</p>
          <div class="mt-6 flex flex-col gap-3">
            <a href={cta} target="_blank" rel="noopener" class="text-center bg-green-50 text-green-800 px-8 py-3.5 min-h-[48px] inline-flex items-center justify-center rounded-full font-bold active:scale-[0.97] transition">Reservasi via WA</a>
            <a href={business.gofood} target="_blank" rel="noopener" class="text-center border border-green-50/40 px-8 py-3.5 min-h-[48px] inline-flex items-center justify-center rounded-full font-semibold hover:bg-green-50/10 transition">Pesan via GoFood</a>
          </div>
          <p class="mt-3 font-mono-num text-xs text-green-200">07.00–22.00 setiap hari</p>
        </div>
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</BaseLayout>
