---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, menuGroups, notes } from '../data/business';
const cta = `https://wa.me/${business.phone}?text=${encodeURIComponent('Halo Cosera Resto, saya mau reservasi meja.')}`;
const andalan = menuGroups[0].items.slice(0, 3);
const testimoni = [
  { q: 'Steaknya juicy, porsinya tidak pelit. Anak-anak betah, orang tua tenang.', by: 'Keluarga, Jelutung', g: '#%?&*!' },
  { q: 'Sarapan jam tujuh sebelum kantor — soto beningnya juara.', by: 'Karyawan, Sipin', g: '*&^%$#' },
  { q: 'Booking arisan via WA dibalas cepat, meja sudah siap saat datang.', by: 'Ibu-ibu arisan', g: '%$#@!*' },
];
---
<BaseLayout title="CO.SERA Jambi — Resto Keluarga & Sarapan 07.00 di Sipin" description="CO.SERA resto & coffee Sipin Jambi: resto keluarga buka 07.00–22.00 tiap hari. Tenderloin steak, soto ayam, carbonara, paket acara. Reservasi 0822-7807-1017." canonicalPath={business.canonicalPath} image={business.ogImage}>
  <section class="max-w-6xl mx-auto px-4 w-full pt-10 md:pt-14">
    <p class="font-mono-num text-xs tracking-[0.18em] uppercase text-green-800 reveal">Resto keluarga &bull; Buka 07.00&ndash;22.00 &bull; Rating {business.rating}</p>
    <h1 class="font-editorial mt-4 text-4xl md:text-6xl leading-[1.04] font-bold max-w-[16ch] reveal">Sarapan pagi, kumpul malam — semua acara keluarga di satu meja.</h1>
    <div class="mt-6 grid grid-cols-1 md:grid-cols-12 gap-6 items-end">
      <p class="md:col-span-7 text-base text-stone-600 leading-relaxed reveal">Di Jl. Sumantri Brojonegoro No.119: tenderloin steak Rp149,5rb, soto ayam Rp45,5rb, carbonara Rp71,5rb (harga GoFood terverifikasi). Sarapan, makan siang, sampai nongkrong malam.</p>
      <div class="md:col-span-5 flex flex-wrap gap-3 md:justify-end reveal">
        <a href={cta} target="_blank" rel="noopener" class="bg-green-800 text-green-50 px-7 py-3.5 rounded-full font-semibold transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Reservasi via WA</a>
        <a href="/menu" class="border border-stone-300 px-7 py-3.5 rounded-full font-semibold hover:border-green-800 hover:text-green-800 active:scale-[0.97] transition">Baca Menu</a>
      </div>
    </div>
    <figure class="mt-8 reveal">
      <img src="/images/cosera-steak.jpg" alt="Tenderloin steak juicy di atas hot plate — CO.SERA Jambi" width="1000" height="562" loading="eager" fetchpriority="high" class="w-full aspect-[16/9] object-cover rounded-2xl border border-green-800/15" />
      <figcaption class="mt-2 flex flex-wrap justify-between gap-2 text-xs text-stone-500"><span>Tenderloin steak — menu terlaris GoFood CO.SERA Jelutung.</span><span class="font-mono-num">Foto ilustrasi sejenis &mdash; ganti foto asli</span></figcaption>
    </figure>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12 w-full">
    <div class="rule-double pt-6 grid grid-cols-1 md:grid-cols-12 gap-6">
      <div class="md:col-span-4">
        <p class="font-mono-num text-xs tracking-[0.18em] uppercase text-green-800">Dari dapur</p>
        <h2 class="font-editorial mt-2 text-3xl md:text-4xl leading-none font-bold">Koran kuliner CO.SERA</h2>
        <p class="mt-3 text-base text-stone-600">Tiga terlaris terverifikasi GoFood. Harga dine-in bisa berbeda dan belum termasuk PPN.</p>
        <a href="/menu" class="mt-4 inline-block text-sm font-semibold underline underline-offset-4 decoration-green-800">Buka e-menu lengkap</a>
      </div>
      <ol class="md:col-span-8 divide-y divide-green-800/15 border-y border-green-800/15">
        {andalan.map((m, i) => (
          <li class="py-5 flex gap-5 items-baseline">
            <span class="font-mono-num text-sm text-green-800">{String(i + 1).padStart(2, '0')}</span>
            <div class="flex-1">
              <h3 class="font-editorial text-xl font-bold">{m.name}</h3>
              <p class="mt-0.5 text-sm text-stone-600">{m.desc}</p>
            </div>
            <p class="font-mono-num font-semibold text-green-800 whitespace-nowrap">{m.price}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-6 w-full">
    <div class="bg-green-800 text-green-50 rounded-2xl p-8 md:p-10 grid gap-6 md:grid-cols-12 md:items-center">
      <div class="md:col-span-7">
        <p class="font-mono-num text-xs tracking-[0.18em] uppercase text-green-200">Pagi hari</p>
        <h2 class="font-editorial mt-2 text-3xl md:text-4xl font-bold leading-tight">Lapar jam tujuh? Dapur sudah menyala.</h2>
        <p class="mt-2 text-green-100/90">Satu dari sedikit resto Sipin yang buka 07.00 — sarapan keluarga sebelum sekolah dan kantor.</p>
      </div>
      <div class="md:col-span-5 md:text-right">
        <a href={cta} target="_blank" rel="noopener" class="inline-block bg-green-50 text-green-800 px-8 py-3.5 rounded-full font-bold active:scale-[0.97] transition">Sarapan di CO.SERA</a>
        <p class="mt-2 font-mono-num text-xs text-green-200">07.00&ndash;22.00 setiap hari</p>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-5">
        <p class="font-mono-num text-xs tracking-[0.18em] uppercase text-green-800">Paket acara</p>
        <h2 class="font-editorial mt-2 text-3xl md:text-4xl leading-none font-bold">Rapat sampai ulang tahun</h2>
        <p class="dropcap mt-4 text-base text-stone-600 leading-relaxed">Empat paket grup untuk rapat kantor, selebrasi, arisan, dan katering. Kapasitas dan harga dikonfirmasi via WA — tanpa DP misterius.</p>
        <a href="/acara" class="mt-4 inline-block text-sm font-semibold underline underline-offset-4 decoration-green-800">Lihat paket acara</a>
      </div>
      <div class="md:col-span-7">
        <div class="curtain rounded-2xl">
          <img src="/images/cosera-nasgor.jpg" alt="Nasi goreng kampung dengan telur dan kerupuk" width="1000" height="562" loading="lazy" class="w-full aspect-[16/9] object-cover" />
        </div>
        <p class="mt-2 text-xs text-stone-500">Tirai tersibak saat terlihat &mdash; ilustrasi menu sejenis, ganti foto asli.</p>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12 w-full">
    <p class="font-mono-num text-xs tracking-[0.18em] uppercase text-green-800">Kata pengunjung</p>
    <h2 class="font-editorial mt-2 text-3xl md:text-4xl font-bold">Arahkan kursor, dengar bisiknya</h2>
    <div class="mt-6 divide-y divide-green-800/15 border-y border-green-800/15">
      {testimoni.map((t) => (
        <blockquote class="t py-6 cursor-default">
          <p class="q font-editorial text-xl md:text-2xl italic leading-snug">&ldquo;{t.q}&rdquo; <span class="glyphs font-mono-num not-italic text-sm text-green-800">{t.g}</span></p>
          <cite class="mt-2 block font-mono-num text-xs text-stone-500 not-italic">&mdash; {t.by}</cite>
        </blockquote>
      ))}
    </div>
    <p class="mt-3 text-xs text-stone-400">Kutipan ilustratif dari ulasan &mdash; ganti kutipan asli berizin.</p>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-5">
        <p class="font-mono-num text-xs tracking-[0.18em] uppercase text-green-800">Lokasi</p>
        <h2 class="font-editorial mt-2 text-3xl md:text-4xl font-bold">Rating <span class="font-mono-num">{business.rating}</span> di Google Maps</h2>
        <p class="mt-3 text-base text-stone-600 leading-relaxed">{business.address}. <a class="underline underline-offset-4 decoration-green-800 text-stone-800" href={business.mapsUrl} target="_blank" rel="noopener">Lihat di Google Maps</a></p>
        {notes.map((n) => (<p class="mt-3 text-sm text-stone-500 border-l-2 border-green-800 pl-3">{n}</p>))}
      </div>
      <div class="md:col-span-7">
        <div class="rounded-2xl overflow-hidden border border-green-800/15 aspect-video bg-green-800/5">
          <iframe title={`Peta ${business.name}`} src={business.mapsEmbed} loading="lazy" class="w-full h-full"></iframe>
        </div>
        <p class="mt-3 text-xs text-stone-500">{business.address} &mdash; {business.hours}</p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href={cta} target="_blank" rel="noopener" class="bg-green-800 text-green-50 px-8 py-3.5 rounded-full font-semibold active:scale-[0.97] transition">Reservasi via WA</a>
          <a href={business.gofood} target="_blank" rel="noopener" class="border border-stone-300 px-8 py-3.5 rounded-full font-semibold hover:border-green-800 hover:text-green-800 active:scale-[0.97] transition">Pesan via GoFood</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
