---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/business';
const shots = [
  { f: 'cosera-steak.jpg', w: 1000, h: 667, alt: 'Tenderloin steak juicy di atas hot plate' },
  { f: 'cosera-soto.jpg', w: 1000, h: 750, alt: 'Mangkuk soto ayam bening dengan suwiran ayam' },
  { f: 'cosera-carbonara.jpg', w: 1000, h: 562, alt: 'Spaghetti carbonara creamy dengan taburan keju' },
  { f: 'cosera-nasgor.jpg', w: 1000, h: 689, alt: 'Nasi goreng kampung dengan telur dan kerupuk' },
  { f: 'cosera-kopsus.jpg', w: 1000, h: 1301, alt: 'Es kopi susu kekinian dalam gelas plastik' },
  { f: 'cosera-matcha.jpg', w: 1000, h: 1000, alt: 'Matcha latte dengan latte art di cangkir' },
];
---
<BaseLayout title={`Galeri menu — ${business.name}`} description="Galeri menu CO.SERA Jambi: steak, soto ayam, carbonara, nasi goreng, kopi susu, matcha. Foto ilustrasi sejenis, ganti foto asli." canonicalPath="/galeri" image="/images/cosera-carbonara.jpg">
  <section class="max-w-7xl mx-auto px-4 pt-12 w-full">
    <p class="text-sm font-medium text-amber-700">Galeri</p>
    <h1 class="mt-2 text-4xl md:text-5xl tracking-tighter leading-none font-bold">Intip menunya dulu</h1>
    <p class="mt-4 text-base text-gray-600 max-w-[65ch]">Foto di bawah adalah ilustrasi menu sejenis berlisensi bebas (bukan foto asli resto). Lihat versi aslinya di Instagram @cosera.id atau datang langsung.</p>
  </section>
  <section class="max-w-7xl mx-auto px-4 py-10 w-full">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-12 gap-6">
      {shots.map((s, i) => (
        <figure class:list={['reveal', i % 3 === 0 ? 'md:col-span-7' : 'md:col-span-5']}>
          <img src={`/images/${s.f}`} alt={s.alt} width={s.w} height={s.h} loading="lazy" class="w-full h-72 object-cover rounded-[2.5rem] border border-slate-200/50" />
          <figcaption class="mt-3 text-xs text-zinc-400 px-2">{s.alt}. Sumber: Wikimedia Commons — ganti foto asli.</figcaption>
        </figure>
      ))}
    </div>
  </section>
</BaseLayout>
