---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, menuGroups } from '../data/business';
const badgeCls = (s: string) =>
  s.includes('Terverifikasi') ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800';
const imgFile: Record<string, { f: string; w: number; h: number }> = {
  steak: { f: 'cosera-steak.jpg', w: 1000, h: 667 },
  soto: { f: 'cosera-soto.jpg', w: 1000, h: 750 },
  carbonara: { f: 'cosera-carbonara.jpg', w: 1000, h: 562 },
  nasgor: { f: 'cosera-nasgor.jpg', w: 1000, h: 689 },
  kopsus: { f: 'cosera-kopsus.jpg', w: 1000, h: 1301 },
  matcha: { f: 'cosera-matcha.jpg', w: 1000, h: 1000 },
};
---
<BaseLayout title={`E-menu — ${business.name}`} description="E-menu CO.SERA Jambi: tenderloin steak, soto ayam, carbonara, nasi goreng, kopi susu, matcha dengan harga terverifikasi GoFood." canonicalPath="/menu" image="/images/cosera-soto.jpg">
  <section class="max-w-7xl mx-auto px-4 pt-12 w-full">
    <p class="text-sm font-medium text-amber-700">E-Menu</p>
    <h1 class="mt-2 text-4xl md:text-5xl tracking-tighter leading-none font-bold max-w-[20ch]">Menu nasional sampai internasional</h1>
    <p class="mt-4 text-base text-gray-600 max-w-[65ch]">Label hijau berarti harga terverifikasi GoFood. Harga dine-in dapat berbeda dan belum termasuk PPN.</p>
  </section>
  {menuGroups.map((g) => (
    <section class="max-w-7xl mx-auto px-4 py-8 w-full">
      <h2 class="text-2xl md:text-3xl tracking-tighter font-bold">{g.category}</h2>
      <div class="mt-6 grid grid-cols-1 md:grid-cols-12 gap-6">
        {g.items.map((m, i) => (
          <article class:list={['reveal', i % 3 === 0 ? 'md:col-span-7' : 'md:col-span-5']}>
            <div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-8 h-full">
              <img src={`/images/${imgFile[m.img].f}`} alt={m.name} width={imgFile[m.img].w} height={imgFile[m.img].h} loading="lazy" class="w-full h-52 object-cover rounded-3xl" />
              <p class="mt-4 text-xs font-medium"><span class={`px-3 py-1.5 rounded-full ${badgeCls(m.status)}`}>{m.status}</span></p>
              <h3 class="mt-2 font-semibold text-lg tracking-tight">{m.name}</h3>
              <p class="font-mono-num font-semibold mt-1">{m.price}</p>
              <p class="mt-1 text-sm text-gray-600">{m.desc}</p>
            </div>
            <p class="mt-3 text-xs text-zinc-400 px-2">Foto ilustrasi menu sejenis (Wikimedia Commons) — ganti foto asli.</p>
          </article>
        ))}
      </div>
    </section>
  ))}
  <section class="max-w-7xl mx-auto px-4 py-10 w-full">
    <div class="md:pl-[12vw]">
      <a href={business.gofood} target="_blank" rel="noopener" class="inline-block bg-amber-700 text-white px-8 py-3.5 rounded-full font-medium">Pesan via GoFood</a>
    </div>
  </section>
</BaseLayout>
