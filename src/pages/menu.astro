---
import BaseLayout from '../layouts/BaseLayout.astro';
import DishCard from '../components/DishCard.astro';
import { business, menuGroups, waLink } from '../data/business';
const imgFile: Record<string, { f: string; w: number; h: number }> = {
  steak: { f: 'cosera-steak.webp', w: 1000, h: 667 },
  soto: { f: 'cosera-soto.webp', w: 1000, h: 750 },
  carbonara: { f: 'cosera-carbonara.webp', w: 1000, h: 562 },
  nasgor: { f: 'cosera-nasgor.webp', w: 1000, h: 689 },
  kopsus: { f: 'cosera-kopsus.webp', w: 1000, h: 1301 },
  matcha: { f: 'cosera-matcha.webp', w: 1000, h: 1000 },
};
const total = menuGroups.reduce((a, g) => a + g.items.length, 0);
const menuLd = {
  '@context': 'https://schema.org', '@type': 'Menu', name: `E-Menu ${business.name}`,
  hasMenuSection: menuGroups.map((g) => ({
    '@type': 'MenuSection', name: g.category,
    hasMenuItem: g.items.map((m) => ({ '@type': 'MenuItem', name: m.name, description: m.desc, offers: { '@type': 'Offer', price: m.price } })),
  })),
};
---
<BaseLayout title="E-Menu CO.SERA Jambi — Steak, Soto & Carbonara" description="E-menu CO.SERA Jambi: tenderloin steak Rp149,5rb, soto ayam Rp45,5rb, carbonara Rp71,5rb terverifikasi GoFood. Pesan tiap item via WA, dine-in bisa berbeda." canonicalPath="/menu" image="/images/cosera-soto.webp">
  <!-- Ref: Awwwards GEM fullscreen menu + Themetags menu highlight visual -->
  <section class="max-w-6xl mx-auto px-4 pt-12 md:pt-16 w-full">
    <p class="font-mono-num text-xs tracking-[0.18em] uppercase text-green-800">E-Menu &bull; {total} menu</p>
    <h1 class="font-editorial mt-2 text-4xl md:text-6xl leading-[1.04] font-bold max-w-[16ch]">Dari steak sampai soto, semua tercatat</h1>
    <p class="dropcap mt-4 text-base text-stone-600 max-w-[65ch]">Label hijau = harga terverifikasi GoFood — harga dine-in dapat berbeda dan belum termasuk PPN. Setiap item bisa dipesan langsung via WA.</p>
    <!-- Skeleton: tampil saat gambar dimuat -->
    <div id="menu-skel" class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-5" aria-hidden="true">
      {[0, 1, 2, 3].map(() => (
        <div class="border border-green-800/15 rounded-2xl overflow-hidden bg-white/50">
          <div class="skel-block w-full aspect-video"></div>
          <div class="p-6 space-y-3"><div class="skel-block h-5 w-2/3 rounded-full"></div><div class="skel-block h-4 w-1/3 rounded-full"></div></div>
        </div>
      ))}
    </div>
    <div id="menu-real" class="hidden">
      {menuGroups.map((g) => (
        <div class="mt-12">
          <div class="rule-double pt-4 flex items-baseline justify-between gap-4 min-w-0">
            <h2 class="font-editorial text-2xl md:text-3xl font-bold min-w-0">{g.category}</h2>
            <span class="font-mono-num text-sm text-green-800 shrink-0">{String(g.items.length).padStart(2, '0')} menu</span>
          </div>
          <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-5">
            {g.items.map((m) => (
              <DishCard name={m.name} price={m.price} badge={m.status} desc={m.desc} img={`/images/${imgFile[m.img].f}`} imgW={imgFile[m.img].w} imgH={imgFile[m.img].h} waHref={waLink(`Halo Cosera Resto, saya mau pesan ${m.name} (${m.price}). Apakah tersedia?`)} />
            ))}
          </div>
        </div>
      ))}
      <div class="mt-8 flex flex-col sm:flex-row gap-3 pb-4">
        <a href={waLink('Halo Cosera Resto, saya mau tanya menu lengkap hari ini.')} target="_blank" rel="noopener" class="flex-1 text-center bg-green-800 text-green-50 px-6 py-3 min-h-[48px] inline-flex items-center justify-center rounded-full text-sm font-semibold">Tanya menu via WA</a>
        <a href={business.gofood} target="_blank" rel="noopener" class="flex-1 text-center border border-stone-300 px-6 py-3 min-h-[48px] inline-flex items-center justify-center rounded-full text-sm font-semibold hover:border-green-800 hover:text-green-800 transition">Pesan via GoFood</a>
      </div>
    </div>
  </section>
  <script is:inline>
    (function () {
      function show() {
        var s = document.getElementById('menu-skel');
        var r = document.getElementById('menu-real');
        if (s) s.classList.add('hidden');
        if (r) r.classList.remove('hidden');
      }
      if (document.readyState === 'complete') setTimeout(show, 350);
      else window.addEventListener('load', function () { setTimeout(show, 350); });
      setTimeout(show, 2500);
    })();
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(menuLd)} />
</BaseLayout>
