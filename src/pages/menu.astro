---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, menuGroups } from '../data/business';
const menuLd = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: `E-Menu ${business.name}`,
  hasMenuSection: menuGroups.map((g) => ({
    '@type': 'MenuSection',
    name: g.category,
    hasMenuItem: g.items.map((m) => ({ '@type': 'MenuItem', name: m.name, description: m.desc, offers: { '@type': 'Offer', price: m.price } })),
  })),
};
const imgFile: Record<string, { f: string; w: number; h: number }> = {
  steak: { f: 'cosera-steak.jpg', w: 1000, h: 667 },
  soto: { f: 'cosera-soto.jpg', w: 1000, h: 750 },
  carbonara: { f: 'cosera-carbonara.jpg', w: 1000, h: 562 },
  nasgor: { f: 'cosera-nasgor.jpg', w: 1000, h: 689 },
  kopsus: { f: 'cosera-kopsus.jpg', w: 1000, h: 1301 },
  matcha: { f: 'cosera-matcha.jpg', w: 1000, h: 1000 },
};
let no = 0;
---
<BaseLayout title="E-Menu CO.SERA Jambi — Steak, Soto & Carbonara" description="E-menu CO.SERA Jambi: tenderloin steak Rp149,5rb, soto ayam Rp45,5rb, carbonara Rp71,5rb terverifikasi GoFood. Nomor mono, harga transparan, dine-in bisa berbeda." canonicalPath="/menu" image="/images/cosera-soto.jpg">
  <section class="max-w-6xl mx-auto px-4 pt-12 w-full">
    <p class="font-mono-num text-xs tracking-[0.18em] uppercase text-green-800">E-Menu &bull; koran kuliner</p>
    <h1 class="font-editorial mt-2 text-4xl md:text-6xl leading-[1.04] font-bold max-w-[16ch]">Dari steak sampai soto, semua tercatat</h1>
    <p class="dropcap mt-4 text-base text-stone-600 max-w-[65ch]">Nomor urut gaya koran, harga gaya mesin kasir. Label hijau berarti harga terverifikasi GoFood — harga dine-in dapat berbeda dan belum termasuk PPN.</p>
  </section>
  {menuGroups.map((g) => (
    <section class="max-w-6xl mx-auto px-4 py-8 w-full">
      <div class="rule-double pt-4 flex items-baseline justify-between gap-4">
        <h2 class="font-editorial text-2xl md:text-3xl font-bold">{g.category}</h2>
        <span class="font-mono-num text-sm text-green-800">{String(g.items.length).padStart(2, '0')} menu</span>
      </div>
      <ol class="mt-2 divide-y divide-green-800/15">
        {g.items.map((m) => {
          no += 1;
          const n = no;
          return (
            <li class="py-6 grid gap-4 sm:grid-cols-12 sm:items-center">
              <span class="font-mono-num text-sm text-green-800 sm:col-span-1">{String(n).padStart(2, '0')}</span>
              <img src={`/images/${imgFile[m.img].f}`} alt={m.name} width={imgFile[m.img].w} height={imgFile[m.img].h} loading="lazy" class="w-full h-44 object-cover rounded-2xl sm:col-span-4" />
              <div class="sm:col-span-5">
                <p class="text-xs font-semibold text-green-800">{m.status}</p>
                <h3 class="font-editorial mt-0.5 text-xl font-bold">{m.name}</h3>
                <p class="mt-1 text-sm text-stone-600">{m.desc}</p>
              </div>
              <p class="font-mono-num font-semibold text-green-800 sm:col-span-2 sm:text-right">{m.price}</p>
            </li>
          );
        })}
      </ol>
      <p class="mt-2 text-xs text-stone-400">Foto ilustrasi menu sejenis &mdash; ganti foto asli.</p>
    </section>
  ))}
  <section class="max-w-6xl mx-auto px-4 py-10 w-full">
    <div class="md:pl-[12vw]">
      <a href={business.gofood} target="_blank" rel="noopener" class="inline-block bg-green-800 text-green-50 px-8 py-3.5 rounded-full font-semibold active:scale-[0.97] transition">Pesan via GoFood</a>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(menuLd)} />
</BaseLayout>
