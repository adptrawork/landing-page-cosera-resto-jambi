---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 — Halaman di luar menu CO.SERA" description="Halaman tidak ditemukan di CO.SERA Jambi. Kembali ke beranda.">
  <div class="max-w-6xl mx-auto px-4 py-20">
    <p class="font-mono-num text-xs tracking-[0.18em] uppercase text-green-800">Kolom 404</p>
    <h1 class="font-editorial mt-2 text-4xl md:text-6xl font-bold">Halaman ini tidak ada di menu</h1>
    <p class="mt-3 text-base text-stone-600">Tapi meja untuk keluargamu tetap tersedia.</p>
    <a href="/" class="mt-6 inline-block bg-green-800 text-green-50 px-7 py-3 rounded-full font-semibold active:scale-[0.97] transition">Kembali ke beranda</a>
  </div>
</BaseLayout>
