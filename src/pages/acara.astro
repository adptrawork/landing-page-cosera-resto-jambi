---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, eventPackages } from '../data/business';
const cta = (p: string) => `https://wa.me/${business.phone}?text=${encodeURIComponent(`Halo Cosera Resto, saya mau tanya paket ${p}.`)}`;
---
<BaseLayout title={`Paket acara — ${business.name}`} description="Paket rapat, ulang tahun, arisan, dan katering CO.SERA Jambi. Kapasitas dan harga via reservasi WA 0822-7807-1017." canonicalPath="/acara" image="/images/cosera-nasgor.jpg">
  <section class="max-w-7xl mx-auto px-4 pt-12 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-end">
      <div class="md:col-span-7 reveal">
        <p class="text-sm font-medium text-amber-700">Paket Acara</p>
        <h1 class="mt-2 text-4xl md:text-5xl tracking-tighter leading-none font-bold">Rapat, ultah, arisan, katering</h1>
        <p class="mt-4 text-base text-gray-600 max-w-[65ch]">CO.SERA menerima acara grup dan family gathering. Kapasitas ruangan dan harga paket dikonfirmasi via WA — tanpa DP misterius.</p>
      </div>
      <div class="md:col-span-5 reveal">
        <img src="/images/cosera-nasgor.jpg" alt="Nasi goreng kampung dengan telur dan kerupuk" width="1000" height="689" loading="lazy" class="w-full h-56 object-cover rounded-[2.5rem] border border-slate-200/50" />
        <p class="mt-3 text-xs text-zinc-400">Sumber: Wikimedia Commons (ilustrasi menu sejenis) — ganti foto asli</p>
      </div>
    </div>
  </section>
  <section class="max-w-7xl mx-auto px-4 py-10 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      {eventPackages.map((e, i) => (
        <article class:list={['reveal', i % 2 === 0 ? 'md:col-span-7' : 'md:col-span-5']}>
          <div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-8 md:p-10 h-full">
            <h2 class="font-semibold text-lg tracking-tight">{e.name}</h2>
            <p class="mt-1 text-base text-gray-600">{e.desc}</p>
            <div class="mt-4 flex items-center justify-between">
              <p class="font-mono-num font-semibold">{e.price}</p>
              <a href={cta(e.name)} target="_blank" rel="noopener" class="bg-zinc-950 text-white px-5 py-2.5 rounded-full text-sm font-medium">Tanya paket</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="max-w-7xl mx-auto px-4 py-10 w-full">
    <div class="bg-zinc-950 text-white rounded-[2.5rem] p-8 md:p-10">
      <h2 class="font-semibold text-lg tracking-tight">Cara booking acara</h2>
      <ol class="mt-4 space-y-3 text-sm text-zinc-300 list-decimal list-inside">
        <li>Chat WA dengan tanggal, jam, dan jumlah tamu.</li>
        <li>Admin konfirmasi slot ruangan dan paket menu.</li>
        <li>Datang dan rayakan — pembayaran transparan di tempat.</li>
      </ol>
    </div>
  </section>
</BaseLayout>
