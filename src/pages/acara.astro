---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, eventPackages } from '../data/business';
const cta = (p: string) => `https://wa.me/${business.phone}?text=${encodeURIComponent(`Halo Cosera Resto, saya mau tanya paket ${p}.`)}`;
const langkah = [
  { n: '01', t: 'Chat WA', d: 'Kirim tanggal, jam, dan jumlah tamu.' },
  { n: '02', t: 'Konfirmasi slot', d: 'Admin membalas ruangan dan paket menu.' },
  { n: '03', t: 'Datang & rayakan', d: 'Pembayaran transparan di tempat.' },
];
---
<BaseLayout title="Paket Acara CO.SERA Jambi — Rapat, Ultah & Arisan" description="Paket rapat kantor, ulang tahun keluarga, arisan, dan katering CO.SERA Jambi. Tirai tersibak per paket — kapasitas dan harga via WA 0822-7807-1017." canonicalPath="/acara" image="/images/cosera-nasgor.jpg">
  <section class="max-w-6xl mx-auto px-4 pt-12 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-end">
      <div class="md:col-span-7 reveal">
        <p class="font-mono-num text-xs tracking-[0.18em] uppercase text-green-800">Paket acara &bull; <span class="font-mono-num">{String(eventPackages.length).padStart(2, '0')} paket</span></p>
        <h1 class="font-editorial mt-2 text-4xl md:text-6xl leading-[1.04] font-bold">Tirai dibuka untuk acaramu</h1>
        <p class="mt-4 text-base text-stone-600 max-w-[65ch]">CO.SERA menerima acara grup dan family gathering. Setiap foto di bawah tersibak seperti tirai panggung saat kamu menggulir.</p>
      </div>
      <div class="md:col-span-5 reveal">
        <div class="curtain rounded-2xl">
          <img src="/images/cosera-nasgor.jpg" alt="Nasi goreng kampung dengan telur dan kerupuk" width="1000" height="562" loading="lazy" class="w-full aspect-[16/9] object-cover" />
        </div>
        <p class="mt-2 text-xs text-stone-400">Ilustrasi menu sejenis &mdash; ganti foto asli</p>
      </div>
    </div>
  </section>
  <section class="max-w-6xl mx-auto px-4 py-10 w-full">
    <div class="rule-double pt-6 grid grid-cols-1 md:grid-cols-12 gap-6">
      {eventPackages.map((e, i) => (
        <article class:list={['reveal', i % 2 === 0 ? 'md:col-span-7' : 'md:col-span-5']}>
          <div class="border border-green-800/15 rounded-2xl p-8 h-full bg-white/50">
            <p class="font-mono-num text-sm text-green-800">{String(i + 1).padStart(2, '0')}</p>
            <h2 class="font-editorial mt-1 text-2xl font-bold">{e.name}</h2>
            <p class="mt-1 text-base text-stone-600">{e.desc}</p>
            <div class="mt-4 flex items-center justify-between gap-3">
              <p class="font-mono-num font-semibold">{e.price}</p>
              <a href={cta(e.name)} target="_blank" rel="noopener" class="border border-green-800 text-green-800 px-5 py-2.5 rounded-full text-sm font-semibold hover:bg-green-800 hover:text-green-50 active:scale-[0.97] transition">Tanya paket</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="max-w-6xl mx-auto px-4 py-10 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center bg-green-800 text-green-50 rounded-2xl p-8 md:p-10">
      <h2 class="font-editorial md:col-span-5 text-2xl md:text-3xl font-bold">Booking acara dalam 3 babak</h2>
      <ol class="md:col-span-7 divide-y divide-green-50/20 border-y border-green-50/20">
        {langkah.map((l) => (
          <li class="py-4 flex gap-5">
            <span class="font-mono-num text-sm text-green-200">{l.n}</span>
            <div><p class="font-semibold">{l.t}</p><p class="text-sm text-green-100/85">{l.d}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>
