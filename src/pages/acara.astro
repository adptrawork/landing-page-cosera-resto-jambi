---
import BaseLayout from '../layouts/BaseLayout.astro';
import StepsReservasi from '../components/StepsReservasi.astro';
import { business, eventPackages } from '../data/business';
const cta = (p: string) => `https://wa.me/${business.phone}?text=${encodeURIComponent(`Halo Cosera Resto, saya mau tanya paket ${p}.`)}`;
const grup = `https://wa.me/${business.phone}?text=${encodeURIComponent('Halo Cosera Resto, saya mau booking acara grup. Mohon info kapasitas dan paket.')}`;
---
<BaseLayout title="Paket Acara CO.SERA Jambi — Rapat, Ultah & Arisan" description="Paket rapat kantor, ulang tahun keluarga, arisan, dan katering CO.SERA Jambi. Kapasitas dan harga via WA 0822-7807-1017." canonicalPath="/acara" image="/images/cosera-nasgor.jpg">
  <section class="max-w-6xl mx-auto px-4 pt-12 md:pt-16 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-end">
      <div class="md:col-span-7 reveal min-w-0">
        <p class="font-mono-num text-xs tracking-[0.18em] uppercase text-green-800">Paket acara &bull; {String(eventPackages.length).padStart(2, '0')} paket</p>
        <h1 class="font-editorial mt-2 text-4xl md:text-6xl leading-[1.04] font-bold">Ruang untuk acaramu</h1>
        <p class="mt-4 text-base text-stone-600 max-w-[65ch]">CO.SERA menerima acara grup dan family gathering: rapat kantor, ulang tahun, arisan, hingga katering. Kapasitas dan harga dikonfirmasi via WA.</p>
      </div>
      <div class="md:col-span-5 reveal min-w-0">
        <!-- PERF: dimensi lokal terverifikasi (1000x689) + decoding async -->
        <img src="/images/cosera-nasgor.jpg" alt="Nasi goreng kampung dengan telur dan kerupuk" width="1000" height="689" decoding="async" loading="lazy" class="w-full aspect-video object-cover rounded-2xl border border-green-800/15" />
        <p class="mt-2 text-xs text-stone-400">Ilustrasi menu sejenis &mdash; ganti foto asli</p>
      </div>
    </div>
  </section>
  <!-- Ref: tabel paket → cards (1-col mobile, aman 360px) -->
  <section class="max-w-6xl mx-auto px-4 py-10 md:py-12 w-full" aria-label="Paket acara">
    <div class="rule-double pt-6 grid grid-cols-1 sm:grid-cols-2 gap-5">
      {eventPackages.map((e, i) => (
        <article class="border border-green-800/15 rounded-2xl p-6 sm:p-8 bg-white/50 flex flex-col min-w-0">
          <p class="font-mono-num text-sm text-green-800">{String(i + 1).padStart(2, '0')}</p>
          <h2 class="font-editorial mt-1 text-2xl font-bold leading-snug">{e.name}</h2>
          <p class="mt-1 text-base text-stone-600">{e.desc}</p>
          <div class="mt-4 pt-4 border-t border-green-800/10 flex items-center justify-between gap-3 mt-auto">
            <p class="font-mono-num font-semibold">{e.price}</p>
            <a href={cta(e.name)} target="_blank" rel="noopener" class="border border-green-800 text-green-800 px-5 py-2.5 min-h-[48px] inline-flex items-center rounded-full text-sm font-semibold hover:bg-green-800 hover:text-green-50 active:scale-[0.97] transition">Tanya paket</a>
          </div>
        </article>
      ))}
    </div>
    <div class="mt-6 bg-green-800 text-green-50 rounded-2xl p-8 md:p-10 grid grid-cols-1 md:grid-cols-12 gap-6 md:items-center">
      <div class="md:col-span-8">
        <h2 class="font-editorial text-2xl md:text-3xl font-bold leading-tight">Acara grup bulan ini? Amankan slot.</h2>
        <p class="mt-2 text-green-100/90 text-sm">Satu chat: tanggal, jam, jumlah tamu — admin membalas kapasitas dan paket.</p>
      </div>
      <div class="md:col-span-4 md:text-right">
        <a href={grup} target="_blank" rel="noopener" class="inline-flex items-center justify-center bg-green-50 text-green-800 px-8 py-3.5 min-h-[48px] rounded-full font-bold active:scale-[0.97] transition">CTA grup via WA</a>
      </div>
    </div>
  </section>
  <div class="py-10 md:py-12 border-t border-green-800/10"><StepsReservasi /></div>
</BaseLayout>
